{
  "name": "polypark",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based 3D low-poly resort tycoon. Snap together the park of your dreams.",
  "license": "SEE LICENSE IN README.md",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "content:build": "tsx scripts/build-content.ts",
    "content:check": "tsx scripts/build-content.ts && git diff --exit-code -- public/content public/models",
    "thumbs": "tsx scripts/gen-thumbnails.ts",
    "budgets": "tsx scripts/check-budgets.ts",
    "gate": "pnpm typecheck && pnpm lint && pnpm depcruise && pnpm test && pnpm build && pnpm budgets"
  },
  "dependencies": {
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "fflate": "0.8.3",
    "next": "15.5.22",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "@next/eslint-plugin-next": "15.5.22",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.11",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "dependency-cruiser": "18.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
